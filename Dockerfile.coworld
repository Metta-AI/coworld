FROM ubuntu:24.04 AS supervisor-build
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
COPY src/coworld/runner/pool/supervisor.c /tmp/supervisor.c
RUN gcc -static -O2 -Wall -Wextra -Werror -o /coworld-supervisor /tmp/supervisor.c
COPY src/coworld/runner/task_environments/supervisor.c /tmp/task-supervisor.c
RUN gcc -static -O2 -Wall -Wextra -Werror -o /coworld-task-supervisor /tmp/task-supervisor.c

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    iptables \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.6 /uv /uvx /bin/

COPY --from=supervisor-build /coworld-supervisor /opt/coworld-supervisor
COPY --from=supervisor-build /coworld-task-supervisor /opt/coworld-task-supervisor

ENV UV_HTTP_TIMEOUT=300
RUN uv python install 3.12 && uv venv /opt/coworld

ARG COWORLD_VERSION=""
ARG GIT_COMMIT=""
ENV COWORLD_VERSION=${COWORLD_VERSION}
ENV GIT_COMMIT=${GIT_COMMIT}

RUN --mount=type=bind,target=/ctx \
    if ls /ctx/coworld-*.whl 1>/dev/null 2>&1; then \
        COWORLD_WHEEL=$(ls /ctx/coworld-*.whl) && \
        uv pip install --python /opt/coworld/bin/python "${COWORLD_WHEEL}[task-environments]"; \
    elif [ -n "${COWORLD_VERSION}" ]; then \
        uv pip install --python /opt/coworld/bin/python "coworld[task-environments]==${COWORLD_VERSION}"; \
    else \
        mkdir -p /tmp/coworld-src && \
        cp -a /ctx/. /tmp/coworld-src/ && \
        uv build /tmp/coworld-src --wheel --out-dir /tmp/wheels && \
        COWORLD_WHEEL=$(ls /tmp/wheels/coworld-*.whl) && \
        uv pip install --python /opt/coworld/bin/python "${COWORLD_WHEEL}[task-environments]"; \
    fi

ENV PATH="/opt/coworld/bin:$PATH"

RUN python -c "import sys; import coworld.runner.init_config; assert 'kubernetes' not in sys.modules" \
    && python -c "import coworld.runner.kubernetes_runner"

ENTRYPOINT ["python", "-m", "coworld.runner.kubernetes_runner"]
