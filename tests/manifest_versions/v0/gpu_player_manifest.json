{
  "game": {
    "name": "minimal-coworld",
    "version": "1.0.0",
    "description": "Minimal legacy-compatible Coworld manifest.",
    "owner": "coworld@example.com",
    "config_schema": {},
    "results_schema": {},
    "runnable": {
      "type": "game",
      "image": "example.com/minimal-game:1"
    },
    "protocols": {
      "player": {
        "type": "text",
        "value": "Player protocol"
      },
      "global": {
        "type": "text",
        "value": "Global protocol"
      }
    },
    "docs": {
      "readme": {
        "type": "text",
        "value": "Minimal Coworld"
      }
    }
  },
  "player": [
    {
      "type": "player",
      "image": "example.com/minimal-player:1",
      "id": "minimal-player",
      "name": "Minimal Player",
      "description": "Minimal bundled player.",
      "resources": {
        "requests": {
          "cpu": "2",
          "memory": "12Gi",
          "gpu": 1,
          "instance-type": "g6.xlarge"
        }
      },
      "startup": {
        "port": 8080,
        "path": "/healthz",
        "timeout_seconds": 1200
      }
    }
  ],
  "variants": [
    {
      "id": "default",
      "name": "Default",
      "game_config": {},
      "description": "Minimal variant."
    }
  ],
  "certification": {
    "game_config": {},
    "players": [
      {
        "player_id": "minimal-player"
      }
    ]
  }
}
