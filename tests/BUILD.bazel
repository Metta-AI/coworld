load("@py_deps//:deps.bzl", "PYTEST_OPTS", "TEST_DEPS")
load("//bazel:pyproject.bzl", "pyproject_test")
load("//bazel:pytest.bzl", "pytest_test_typed")
load("//bazel:ruff.bzl", "ruff_lint")

_MANIFEST_COMPATIBILITY = "test_manifest_compatibility.py"
_PACKAGE = "packages/coworld/tests"
_LABEL = "//" + _PACKAGE
_PYTEST_ARGS = [
    "--rootdir=" + _PACKAGE,
    "--confcutdir=" + _PACKAGE,
    "--import-mode=importlib",
    "-p",
    "no:importnb",
    "-o",
    "addopts=",
    "-o",
    "pythonpath=",
] + [
    item
    for key, value in PYTEST_OPTS.get(_LABEL, {}).items()
    for item in ["-o", key + "=" + value]
]

# Bare-source filegroup consumed by //:import_linter_test so grimp can
# walk `packages.coworld.tests` (declared as a root_package in
# .importlinter for the coworld-independence contract). Test deps live
# in `:_tests_lib`; this only ships the .py files for parsing.
filegroup(
    name = "import_linter_srcs",
    srcs = glob(["**/*.py"], exclude = ["**/fixtures/**"]),
    visibility = ["//visibility:public"],
)

# test_types diffs the checked-in generated schema JSONs (kept in
# `:generated_schema_files`) against coworld.types' dynamic Pydantic
# schema output.
pyproject_test(
    test_srcs = glob(
        ["**/test_*.py"],
        exclude = [
            "**/__pycache__/**",
            "**/fixtures/**",
            _MANIFEST_COMPATIBILITY,
        ],
        allow_empty = True,
    ),
    extra_tags = [
        "no-sandbox",
        "requires-network",
    ],
    per_test = {
        "test_commissioner_docs": {"data": ["//packages/coworld:docs_files"]},
        "test_coworld_cookbook": {"data": ["//packages/coworld:docs_files"]},
        "test_coworld_macos_docs": {"data": ["//packages/coworld:docs_files"]},
        "test_coworld_artifact_docs": {"data": ["//packages/coworld:docs_files"]},
        "test_coworld_certify_docs": {"data": ["//packages/coworld:docs_files"]},
        "test_coworld_templates": {"data": ["//packages/coworld:package_metadata_files"]},
        "test_types": {"data": ["//packages/coworld:generated_schema_files"]},
    },
    # `coworld` isn't in .ruff.toml's known-first-party (third-party from
    # app_backend); ship its src tree so the ruff lint sorts the tests'
    # `coworld.*` imports first-party.
    ruff_context = ["//packages/coworld:coworld_lint_srcs"],
    typecheck = False,
)

filegroup(
    name = "manifest_compatibility_fixtures",
    srcs = glob(["manifest_compatibility/*.json"]),
)

# Curated golden fixtures are committed runfiles, so this schema gate is hermetic
# and eligible for remote execution despite the package's network-dependent tests.
pytest_test_typed(
    name = "test_manifest_compatibility",
    srcs = [_MANIFEST_COMPATIBILITY],
    args = _PYTEST_ARGS,
    data = [":manifest_compatibility_fixtures"],
    deps = TEST_DEPS[_LABEL],
)

ruff_lint(
    name = "_manifest_compatibility",
    srcs = [_MANIFEST_COMPATIBILITY],
    context = ["//packages/coworld:coworld_lint_srcs"],
)
